# Port the Express server listens on. The Android panel opens http://<this-machine>:<PORT>
PORT=3000

# Bind address. 0.0.0.0 is required for the panel to reach a laptop on the venue LAN.
HOST=0.0.0.0

# Guards /staff and the CSV export. MUST be changed before the event — the
# server prints a warning on boot while this is still the default.
# Generate one:  node -e "console.log('frt-'+require('crypto').randomBytes(6).toString('hex'))"
STAFF_KEY=absa2026

# Where leads.db (or leads.jsonl) is written. Defaults to ./data
DATA_DIR=./data
